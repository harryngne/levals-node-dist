# Automatically reap orphaned / runaway lvnode menu processes (>3s CPU time or lost SSH TTY)
cleanup_orphan_lvnode(){
  [ "$(id -u)" = 0 ] || return 0
  local pid cput tty cmd
  while read -r pid cput tty cmd; do
    [ -n "$pid" ] || continue
    [ "$pid" = "$$" ] && continue
    [ "$pid" = "$PPID" ] && continue
    case "$cmd" in
      */lvnode*|*"lvnode")
        if [ "$tty" = "?" ] || [ "${cput:-0}" -ge 3 ] 2>/dev/null; then
          kill -9 "$pid" 2>/dev/null || true
        fi
        ;;
    esac
  done < <(ps -eo pid=,cputimes=,tty=,args= 2>/dev/null || true)
}
cleanup_orphan_lvnode

