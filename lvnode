info(){ echo -e "${BLU}==${NC} $*"; }
ok(){   echo -e "${GRN}✓${NC} $*"; }
warn(){ echo -e "${YEL}! $*${NC}"; }
die(){  echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
need_root(){ [ "$(id -u)" = 0 ] || die "$(_m need_root)"; }

# ── Instance name → systemd service name & config directory ──
# Default instance ("", "default", "levals-node"):
#   service = levals-node          dir = /etc/levals-node
# Named instance ("<name>"):
#   service = levals-node-<name>   dir = /etc/levals-node-<name>
INST_LABEL="default"
INST_SVC="levals-node"
INST_DIR="/etc/levals-node"
INST_CFG="/etc/levals-node/config.yml"
INST_UNIT="/etc/systemd/system/levals-node.service"

resolve_inst(){
  local raw="${1:-}"
  raw="${raw%.service}"
  if [ -z "$raw" ] || [ "$raw" = "default" ] || [ "$raw" = "levals-node" ]; then
    INST_LABEL="default"
    INST_SVC="levals-node"
    INST_DIR="/etc/levals-node"
  else
    raw="${raw#levals-node-}"
    [[ "$raw" =~ ^[a-zA-Z0-9._-]+$ ]] || die "$(_m invalid_inst): '$raw' $(_m invalid_inst_detail)"
    INST_LABEL="$raw"
    INST_SVC="levals-node-$raw"
    INST_DIR="/etc/levals-node-$raw"
  fi
  INST_CFG="$INST_DIR/config.yml"
  INST_UNIT="/etc/systemd/system/$INST_SVC.service"
}

inst_exists(){
  [ -f "$INST_UNIT" ] || [ -d "$INST_DIR" ]
}

# Collect all existing instances (returns names for resolve_inst)
all_instances(){
  local found=()
  if [ -f "/etc/systemd/system/levals-node.service" ] || [ -f "/etc/levals-node/config.yml" ]; then
    found+=("default")
  fi
  local p n
  for p in /etc/systemd/system/levals-node-*.service /etc/levals-node-*; do
    [ -e "$p" ] || continue
    n="$(basename "$p")"
    n="${n%.service}"
    n="${n#levals-node-}"
    [ -n "$n" ] || continue
    local dup=0 x
    for x in "${found[@]:-}"; do [ "$x" = "$n" ] && { dup=1; break; }; done
    [ "$dup" = 0 ] && found+=("$n")
  done
  printf '%s\n' "${found[@]:-}" | sed '/^$/d'
}

svc_state_badge(){
  local svc="$1"
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    echo -e "${GRN}$(_m state_running)${NC}"
  elif systemctl is-failed --quiet "$svc" 2>/dev/null; then
    echo -e "${RED}$(_m state_error)${NC}"
  else
    echo -e "${YEL}$(_m state_stopped)${NC}"
  fi
}

svc_boot_badge(){
  local svc="$1"
  if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
    echo -e "${GRN}$(_m boot_enabled)${NC}"
  else
    echo -e "${YEL}$(_m boot_disabled)${NC}"
  fi
}

# Read a simple YAML key value from config.yml
yaml_get(){
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -F':' -v k="$key" '
    $0 ~ "^[[:space:]]*"k"[[:space:]]*:" {
      sub("^[[:space:]]*"k"[[:space:]]*:[[:space:]]*", "", $0)
      sub("[[:space:]]+#.*$", "", $0)
      gsub(/^["'\'']|["'\'']$/, "", $0)
      print $0
      exit
    }
  ' "$file"
}

# Generate standard systemd unit file (always restart even on token expiry / disconnect / revocation for auto-recovery)
write_unit(){
  local svc="$1" cfg="$2" unit="/etc/systemd/system/${1}.service"
  cat > "$unit" <<UNIT
[Unit]
Description=$svc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=$BIN -c $cfg
Restart=always
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
}

# Generate default dns.yml & routes.yml for new instance if not existing
ensure_default_rules(){
  local dir="$1"
  mkdir -p "$dir"
  if [ ! -f "$dir/dns.yml" ]; then
    if [ -f "/etc/levals-node/dns.yml" ] && [ "$dir" != "/etc/levals-node" ]; then
      cp -f "/etc/levals-node/dns.yml" "$dir/dns.yml"
    else
      cat > "$dir/dns.yml" <<'DNS'
strategy: ipv4_first
servers:
  - 1.1.1.1
  - 8.8.8.8
rules:
  - domains: ["keyword:doubleclick", "keyword:adsserver", "keyword:adservice", "keyword:pagead", "keyword:googleads", "keyword:googlesyndication"]
    block: true
  - domains: [ads.google.com, ads.yahoo.com, ads.facebook.com, an.facebook.com, analytics.google.com, pixel.facebook.com, ads-api.twitter.com, tracking.mixpanel.com]
    block: true
DNS
    fi
  fi
  if [ ! -f "$dir/routes.yml" ]; then
    if [ -f "/etc/levals-node/routes.yml" ] && [ "$dir" != "/etc/levals-node" ]; then
      cp -f "/etc/levals-node/routes.yml" "$dir/routes.yml"
    else
      cat > "$dir/routes.yml" <<'ROUTES'
settings:
  block_quic: true
  block_bt: true
  block_private: true

block:
  - type: domain
    values:
      - ads.google.com
      - pagead2.googlesyndication.com
      - googleads.g.doubleclick.net
      - ad.doubleclick.net
      - adservice.google.com
      - ads.yahoo.com
      - ads.facebook.com
      - an.facebook.com
      - pixel.facebook.com
      - analytics.google.com
      - tracking.mixpanel.com
      - ads-api.twitter.com
  - type: keyword
    values:
      - torrent
      - tracker
      - announce
      - peer-exchange
      - seed-peer
  - type: ip
    values: []
ROUTES
    fi
  fi
}

# Normalize YAML value (integers / booleans kept as-is, strings quoted)
fmt_yaml_val(){
  local v="$1"
  if [[ "$v" =~ ^[0-9]+$ ]] || [[ "$v" =~ ^(true|false)$ ]]; then
    printf '%s' "$v"
  else
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    printf '"%s"' "$v"
  fi
}

# Update or add k=v in config.yml
set_yaml_kv(){
  local file="$1" raw_k="$2" raw_v="$3"
  local k="$raw_k"
  case "$raw_k" in
    PANEL_URL|url)         k="api_host" ;;
    TOKEN|token)           k="api_key" ;;
    NODE_ID)               k="node_id" ;;
    LEVALS_KEY)            k="levals_key" ;;
    PANEL_KIND|kind|type)  k="server_type" ;;
    NODE_TYPE)             k="node_type" ;;
    LOG_LEVEL|log_level)   k="log.level" ;;
    LOG_ACCESS|log_access) k="log.access" ;;
  esac
  local fv
  fv="$(fmt_yaml_val "$raw_v")"

  if [[ "$k" == *.* ]]; then
    local sec="${k%%.*}" sub="${k#*.}"
    if grep -qE "^${sec}:[[:space:]]*$" "$file" 2>/dev/null; then
      if awk -v s="$sec" -v sk="$sub" '
        $0 ~ "^"s":[[:space:]]*$" { in_s=1; next }
        in_s && $0 ~ "^[^[:space:]#]" { in_s=0 }
        in_s && $0 ~ "^[[:space:]]+"sk":[[:space:]]*" { found=1 }
        END { exit(found ? 0 : 1) }
      ' "$file"; then
        awk -v s="$sec" -v sk="$sub" -v val="$fv" '
          $0 ~ "^"s":[[:space:]]*$" { in_s=1; print; next }
          in_s && $0 ~ "^[^[:space:]#]" { in_s=0 }
          in_s && $0 ~ "^[[:space:]]+"sk":[[:space:]]*" {
            print "  " sk ": " val
            in_s=0
            next
          }
          { print }
        ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
      else
        awk -v s="$sec" -v sk="$sub" -v val="$fv" '
          $0 ~ "^"s":[[:space:]]*$" { print; print "  " sk ": " val; next }
          { print }
        ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
      fi
    else
      printf '\n%s:\n  %s: %s\n' "$sec" "$sub" "$fv" >> "$file"
    fi
  else
    if grep -qE "^${k}:[[:space:]]*" "$file" 2>/dev/null; then
      awk -v k="$k" -v val="$fv" '
        !done && $0 ~ "^"k":[[:space:]]*" { print k ": " val; done=1; next }
        { print }
      ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
    else
      printf '%s: %s\n' "$k" "$fv" >> "$file"
    fi
  fi
}

usage(){
  echo -e ""
  echo -e "${BLD}$(_m usage_title)${NC}"
  echo "--------------------------------------------------------------------"
  echo "lvnode                              - $(_m u_menu)"
  echo "lvnode list                         - $(_m u_list)"
  echo "lvnode new <name> [k1=v1 ...]       - $(_m u_new)"
  echo "lvnode remove <name> [name...]      - $(_m u_remove)"
  echo "lvnode rename <old_name> <new_name> - $(_m u_rename)"
  echo "lvnode start [name]                 - $(_m u_start)"
  echo "lvnode stop [name]                  - $(_m u_stop)"
  echo "lvnode restart [name]               - $(_m u_restart)"
  echo "lvnode enable [name]                - $(_m u_enable)"
  echo "lvnode disable [name]               - $(_m u_disable)"
  echo "lvnode log [name]                   - $(_m u_log)"
  echo "lvnode log [name] -n <N>            - $(_m u_log_n)"
  echo "lvnode config [name]                - $(_m u_config)"
  echo "lvnode config [name] -e             - $(_m u_config_e)"
  echo "lvnode config [name] k1=v1 k2=v2    - $(_m u_config_kv)"
  echo "lvnode update [version]             - $(_m u_update)"
  echo "lvnode uninstall                    - $(_m u_uninstall)"
  echo "lvnode self-update                  - $(_m u_self_update)"
  echo "lvnode version                      - $(_m u_version)"
  echo "--------------------------------------------------------------------"
}

cmd_list(){
  local items=()
  while IFS= read -r line; do [ -n "$line" ] && items+=("$line"); done < <(all_instances)
  if [ "${#items[@]}" -eq 0 ]; then
    warn "$(_m no_instance)"
    return 0
  fi
  printf "\n${BLD}%-16s %-24s %-16s %-8s %-10s %s${NC}\n" "$(_m hdr_instance)" "$(_m hdr_status)" "$(_m hdr_boot)" "NODE_ID" "$(_m hdr_type)" "$(_m hdr_panel)"
  echo "----------------------------------------------------------------------------------------"
  local it nid stype host
  for it in "${items[@]}"; do
    resolve_inst "$it"
    nid="$(yaml_get "$INST_CFG" "node_id")"
    stype="$(yaml_get "$INST_CFG" "server_type")"
    host="$(yaml_get "$INST_CFG" "api_host")"
    [ -z "$host" ] && host="$(yaml_get "$INST_CFG" "url")"
    printf "%-16s %-33b %-25b %-8s %-10s %s\n" \
      "$INST_LABEL" "$(svc_state_badge "$INST_SVC")" "$(svc_boot_badge "$INST_SVC")" \
      "${nid:--}" "${stype:-levals}" "${host:--}"
  done
  echo ""
}

cmd_new(){
  need_root
  local name="${1:-}"
  [ -n "$name" ] || die "$(_m new_usage)"
  shift || true
  resolve_inst "$name"
  inst_exists && die "$(_m inst_exists) '$INST_LABEL' ($INST_DIR)."

  # Inherit defaults from base instance if available for quick second-node creation
  local def_host="" def_key="" def_lkey="" def_type="levals"
  if [ -f "/etc/levals-node/config.yml" ]; then
    def_host="$(yaml_get /etc/levals-node/config.yml api_host)"
    [ -z "$def_host" ] && def_host="$(yaml_get /etc/levals-node/config.yml url)"
    def_key="$(yaml_get /etc/levals-node/config.yml api_key)"
    [ -z "$def_key" ] && def_key="$(yaml_get /etc/levals-node/config.yml token)"
    def_lkey="$(yaml_get /etc/levals-node/config.yml levals_key)"
    def_type="$(yaml_get /etc/levals-node/config.yml server_type)"
    [ -z "$def_type" ] && def_type="levals"
  fi

  ensure_default_rules "$INST_DIR"
  cat > "$INST_CFG" <<YML
server_type: "${def_type}"
api_host: "${def_host}"
api_key: "${def_key}"
node_id: 1
levals_key: "${def_lkey}"
core:
  engine: native
config_dir: "$INST_DIR"
log:
  level: "info"
YML

  local kv k v
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "$(_m invalid_param) '$kv'"
    k="${kv%%=*}"; v="${kv#*=}"
    set_yaml_kv "$INST_CFG" "$k" "$v"
  done

  # If no CLI params and running in interactive terminal → prompt for key fields
  if [ "$#" -eq 0 ] && [ -t 0 ]; then
    local in_host="" in_key="" in_nid="" in_lkey="" in_ntype=""
    read -rp "$(_m prompt_api_host) [${def_host}]: " in_host || { echo ""; return 0; }
    [ -n "${in_host:-}" ] && set_yaml_kv "$INST_CFG" "api_host" "$in_host"
    read -rp "$(_m prompt_api_key) [${def_key:+$(_m inherited)}]: " in_key || { echo ""; return 0; }
    [ -n "${in_key:-}" ] && set_yaml_kv "$INST_CFG" "api_key" "$in_key"
    read -rp "$(_m prompt_node_id)" in_nid || { echo ""; return 0; }
    [ -n "${in_nid:-}" ] && set_yaml_kv "$INST_CFG" "node_id" "$in_nid"
    read -rp "$(_m prompt_levals_key) [${def_lkey:+$(_m inherited)}]: " in_lkey || { echo ""; return 0; }
    [ -n "${in_lkey:-}" ] && set_yaml_kv "$INST_CFG" "levals_key" "$in_lkey"
    read -rp "$(_m prompt_node_type)" in_ntype || { echo ""; return 0; }
    [ -n "${in_ntype:-}" ] && set_yaml_kv "$INST_CFG" "node_type" "$in_ntype"
  fi

  write_unit "$INST_SVC" "$INST_CFG"
  systemctl daemon-reload
  systemctl enable -q "$INST_SVC" 2>/dev/null || true
  systemctl restart "$INST_SVC"
  ok "$(_m created_started) '$INST_LABEL' ($INST_SVC) → $(svc_state_badge "$INST_SVC")"
}

cmd_remove(){
  need_root
  [ "$#" -ge 1 ] || die "$(_m remove_usage)"
  local name
  for name in "$@"; do
    resolve_inst "$name"
    if ! inst_exists; then
      warn "$(_m inst_not_found) '$INST_LABEL' — $(_m skipping)"
      continue
    fi
    systemctl stop "$INST_SVC" 2>/dev/null || true
    systemctl disable -q "$INST_SVC" 2>/dev/null || true
    rm -f "$INST_UNIT"
    rm -rf "$INST_DIR"
    ok "$(_m removed_inst) '$INST_LABEL' ($INST_SVC)"
  done
  systemctl daemon-reload 2>/dev/null || true
}

cmd_rename(){
  need_root
  local old_n="${1:-}" new_n="${2:-}"
  [ -n "$old_n" ] && [ -n "$new_n" ] || die "$(_m rename_usage)"
  resolve_inst "$old_n"
  local old_label="$INST_LABEL" old_svc="$INST_SVC" old_dir="$INST_DIR" old_unit="$INST_UNIT"
  inst_exists || die "'$old_label' $(_m inst_not_exist)"

  resolve_inst "$new_n"
  local new_label="$INST_LABEL" new_svc="$INST_SVC" new_dir="$INST_DIR" new_cfg="$INST_CFG"
  inst_exists && die "$(_m inst_exists) '$new_label'."

  systemctl stop "$old_svc" 2>/dev/null || true
  systemctl disable -q "$old_svc" 2>/dev/null || true
  rm -f "$old_unit"

  mv "$old_dir" "$new_dir"
  [ -f "$new_cfg" ] && set_yaml_kv "$new_cfg" "config_dir" "$new_dir"
  write_unit "$new_svc" "$new_cfg"
  systemctl daemon-reload
  systemctl enable -q "$new_svc" 2>/dev/null || true
  systemctl restart "$new_svc"
  ok "$(_m renamed_inst) '$old_label' → '$new_label' ($new_svc): $(svc_state_badge "$new_svc")"
}

cmd_svc_act(){
  local act="$1" target="${2:-}"
  need_root
  resolve_inst "$target"
  inst_exists || die "'$INST_LABEL' $(_m inst_no_exist_hint)"
  case "$act" in
    start|stop|restart)
      systemctl "$act" "$INST_SVC"
      echo -e "$INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"
      ;;
    reload)
      systemctl restart "$INST_SVC"
      echo -e "$(_m reloaded_config) $INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"
      ;;
    enable)
      systemctl enable -q "$INST_SVC"
      ok "$(_m enabled_boot) '$INST_LABEL' ($INST_SVC)."
      ;;
    disable)
      systemctl disable -q "$INST_SVC"
      ok "$(_m disabled_boot) '$INST_LABEL' ($INST_SVC)."
      ;;
  esac
}

# Unified log command merging system agent log + client connection log in realtime
cmd_log(){
  local inst="" follow=1 lines=200 explicit_no_follow=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      --no-follow) follow=0; explicit_no_follow=1 ;;
      -n|--lines)
        shift || die "$(_m missing_n_lines)"
        lines="${1:-1000}"
        [ "$explicit_no_follow" = 0 ] && follow=0
        ;;
      -n*)
        lines="${1#-n}"
        [ "$explicit_no_follow" = 0 ] && follow=0
        ;;
      *)
        if [ -z "$inst" ]; then inst="$1"; else die "$(_m unknown_param): $1"; fi
        ;;
    esac
    shift || true
  done

  resolve_inst "$inst"
  inst_exists || die "'$INST_LABEL' $(_m inst_not_exist)"

  if [ "$follow" -eq 1 ]; then
    echo -e "${GRN}$(_m viewing_log) '$INST_LABEL' ($INST_SVC)${NC}"
    # For older binary (< 0.26.1) that doesn't merge access.log into stdout, manually merge access.log stream if present
    local bver
    bver="$("$BIN" --version 2>/dev/null | awk '{print $2}')"
    if [ -n "$bver" ] && [ "$(printf '%s\n0.26.1\n' "$bver" | sort -V | head -n1)" != "0.26.1" ] && [ -f "$INST_DIR/access.log" ]; then
      trap 'kill 0 2>/dev/null; exit 0' INT TERM EXIT
      tail -n 50 -f "$INST_DIR/access.log" &
      journalctl -u "$INST_SVC" -n "$lines" -f --no-hostname
    else
      exec journalctl -u "$INST_SVC" -n "$lines" -f --no-hostname
    fi
  else
    journalctl -u "$INST_SVC" -n "${lines:-1000}" --no-pager --no-hostname
  fi
}

cmd_config(){
  local inst="" edit_mode=0 kvs=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -e|--edit|edit) edit_mode=1 ;;
      *=*) kvs+=("$1") ;;
      *)
        if [ -z "$inst" ] && [ "${#kvs[@]}" -eq 0 ]; then
          inst="$1"
        else
          die "$(_m invalid_config_param) '$1'"
        fi
        ;;
    esac
    shift || true
  done

  resolve_inst "$inst"
  [ -f "$INST_CFG" ] || die "$(_m no_config) $INST_CFG."

  if [ "${#kvs[@]}" -gt 0 ]; then
    need_root
    local kv k v
    for kv in "${kvs[@]}"; do
      k="${kv%%=*}"; v="${kv#*=}"
      set_yaml_kv "$INST_CFG" "$k" "$v"
      ok "$(_m set_key_in) $k → $INST_CFG"
    done
    if [ -f "$INST_UNIT" ]; then
      systemctl restart "$INST_SVC"
      ok "$(_m auto_restarted) '$INST_LABEL' ($INST_SVC): $(svc_state_badge "$INST_SVC")"
    fi
    return 0
  fi

  if [ "$edit_mode" -eq 1 ]; then
    need_root
    local ed="${EDITOR:-}"
    [ -z "$ed" ] && for e in nano vi vim; do command -v "$e" >/dev/null 2>&1 && { ed="$e"; break; }; done
    [ -n "$ed" ] || die "$(_m no_editor) $INST_CFG"
    "$ed" "$INST_CFG"
    if [ -t 0 ] && [ -f "$INST_UNIT" ]; then
      local ans=""
      read -rp "$(_m restart_confirm) '$INST_LABEL' " ans || { echo ""; return 0; }
      [[ "${ans:-Y}" =~ ^[Yy]$ ]] && { systemctl restart "$INST_SVC"; ok "$INST_SVC: $(svc_state_badge "$INST_SVC")"; }
    fi
    return 0
  fi

  echo -e "${BLD}# Instance: $INST_LABEL ($INST_CFG)${NC}"
  echo "--------------------------------------------------------------------"
  cat "$INST_CFG"
  echo "--------------------------------------------------------------------"
  echo -e "$(_m config_tip) ${CYN}lvnode config${inst:+ $inst} k1=v1${NC} $(_m config_or_editor) ${CYN}lvnode config${inst:+ $inst} -e${NC}"
}

detect_arch(){
  case "$(uname -m)" in
    x86_64|amd64)  echo "x86_64" ;;
    aarch64|arm64) echo "aarch64" ;;
    *) die "$(uname -m): $(_m arch_unsupported)" ;;
  esac
}

# Re-sync all existing systemd units to new always-restart config (remove RestartPreventExitStatus=2)
upgrade_all_units(){
  local items=() it
  while IFS= read -r it; do [ -n "$it" ] && items+=("$it"); done < <(all_instances)
  for it in "${items[@]:-}"; do
    resolve_inst "$it"
    if [ -f "$INST_UNIT" ]; then
      sed -i '/^RestartPreventExitStatus=/d' "$INST_UNIT" 2>/dev/null || true
      grep -q '^StartLimitIntervalSec=' "$INST_UNIT" 2>/dev/null || \
        sed -i '/^\[Unit\]/a StartLimitIntervalSec=0' "$INST_UNIT" 2>/dev/null || true
      sed -i 's/^Restart=.*/Restart=always/' "$INST_UNIT" 2>/dev/null || true
    fi
  done
  systemctl daemon-reload 2>/dev/null || true
}

tune_network_sysctls(){
  modprobe tcp_bbr 2>/dev/null || true
  mkdir -p /etc/sysctl.d 2>/dev/null || true
  cat > /etc/sysctl.d/99-levals-node.conf <<'SYSCTL'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 25
net.ipv4.tcp_keepalive_intvl = 10
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 8192
net.ipv4.ip_local_port_range = 10240 65535
SYSCTL
  sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-levals-node.conf >/dev/null 2>&1 || true

  if ! systemctl is-active --quiet xboard-node 2>/dev/null; then
    if crontab -l 2>/dev/null | grep -q 'xbn-kcfg'; then
      crontab -l 2>/dev/null | grep -v 'xbn-kcfg' | crontab - 2>/dev/null || true
      ok "$(_m removed_cron)"
    fi
    rm -f /etc/cron.d/xbn-kcfg* /usr/local/bin/xbn-kcfg*.sh 2>/dev/null || true
    local dev
    for dev in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^sgw[0-9]+$' || true); do
      wg-quick down "$dev" >/dev/null 2>&1 || ip link del "$dev" >/dev/null 2>&1 || true
      systemctl disable --now "wg-quick@${dev}" >/dev/null 2>&1 || true
      ok "$(_m removed_wg_iface) $dev"
    done
  fi
}

cmd_update(){
  need_root
  local req_ver="${1:-}"
  local narch url tag
  narch="$(detect_arch)"
  if [ -n "$req_ver" ]; then
    tag="v${req_ver#v}"
    url="$REL_BASE/download/$tag/levals-node-linux-$narch"
    info "$(_m downloading_ver) $tag ($narch)…"
  else
    url="$REL_BASE/latest/download/levals-node-linux-$narch"
    info "$(_m downloading_latest) ($narch)…"
  fi

  mkdir -p /usr/local/bin
  curl -fL --retry 3 -o "$BIN.new" "$url" || die "$(_m dl_fail) ($url)"
  [ -s "$BIN.new" ] || die "$(_m dl_empty)"
  chmod +x "$BIN.new"
  mv -f "$BIN.new" "$BIN"
  ok "$(_m updated_binary) $($BIN --version 2>/dev/null || echo 'OK')"

  # Also auto-update lvnode script to latest (if downloadable)
  if curl -fsSL --retry 2 -o /usr/local/bin/lvnode.new "$RAW_BASE/lvnode?$(date +%s)" 2>/dev/null && head -n1 /usr/local/bin/lvnode.new | grep -q '^#!/bin/bash'; then
    chmod +x /usr/local/bin/lvnode.new
    mv -f /usr/local/bin/lvnode.new /usr/local/bin/lvnode
    ok "$(_m synced_lvnode)"
  else
    rm -f /usr/local/bin/lvnode.new
  fi

  tune_network_sysctls
  upgrade_all_units

  local items=() it
  while IFS= read -r it; do [ -n "$it" ] && items+=("$it"); done < <(all_instances)
  for it in "${items[@]:-}"; do
    resolve_inst "$it"
    if [ -f "$INST_UNIT" ]; then
      systemctl restart "$INST_SVC" 2>/dev/null || true
      ok "$(_m restarted_inst) '$INST_LABEL' ($INST_SVC): $(svc_state_badge "$INST_SVC")"
    fi
  done
}

cmd_self_update(){
  need_root
  info "$(_m updating_lvnode)"
  curl -fsSL --retry 3 -o /usr/local/bin/lvnode.new "$RAW_BASE/lvnode?$(date +%s)" \
    || die "$(_m dl_script_fail)"
  head -n1 /usr/local/bin/lvnode.new | grep -q '^#!/bin/bash' \
    || { rm -f /usr/local/bin/lvnode.new; die "$(_m dl_invalid)"; }
  chmod +x /usr/local/bin/lvnode.new
  mv -f /usr/local/bin/lvnode.new /usr/local/bin/lvnode
  local new_ver
  new_ver="$(grep -m1 '^LVNODE_VER=' /usr/local/bin/lvnode | cut -d'"' -f2)"
  ok "$(_m updated_lvnode) (v${new_ver:-$LVNODE_VER})."
}

cmd_version(){
  local bver="$(_m ver_not_installed)"
  [ -x "$BIN" ] && bver="$("$BIN" --version 2>/dev/null | awk '{print $2}')"
  echo -e "${BLD}levals-node${NC} : ${GRN}${bver}${NC} ($(uname -m), engine: native Rust)"
  echo -e "${BLD}lvnode CLI${NC}  : v${LVNODE_VER}"
}

cmd_bbr(){
  need_root
  tune_network_sysctls
  local cc qd
  cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')"
  qd="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo '?')"
  [ "$cc" = "bbr" ] && ok "$(_m bbr_ok) (congestion=$cc, qdisc=$qd)" || warn "$(_m bbr_partial)"
}

cmd_speedtest(){
  if command -v speedtest >/dev/null 2>&1; then speedtest
  elif command -v speedtest-cli >/dev/null 2>&1; then speedtest-cli
  else
    need_root
    info "$(_m installing_speedtest)"
    (apt-get update -qq && apt-get install -y -qq speedtest-cli) >/dev/null 2>&1 \
      || yum install -y -q speedtest-cli >/dev/null 2>&1 \
      || pip3 install -q speedtest-cli >/dev/null 2>&1 || true
    command -v speedtest-cli >/dev/null 2>&1 && speedtest-cli || die "$(_m speedtest_fail)"
  fi
}

cmd_uninstall(){
  need_root
  if [ -t 0 ] && [ "${FORCE:-0}" != "1" ]; then
    local ans=""
    read -rp "$(_m confirm_uninstall)" ans || { echo ""; return 0; }
    [[ "${ans:-N}" =~ ^[Yy]$ ]] || { echo "$(_m cancelled)"; return 0; }
  fi
  curl -fsSL "$RAW_BASE/uninstall.sh?$(date +%s)" | bash
}

pick_inst_interactive(){
  local prompt="${1:-$(_m pick_inst_prompt)}" inp=""
  read -t 600 -rp "$prompt" inp || return 1
  printf '%s' "${inp:-}"
}

interactive_menu(){
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    cmd_version
    cmd_list
    usage
    return 0
  fi
  while [ -t 0 ] && [ -t 1 ]; do
    echo -e ""
    echo -e "${BLD}================ $(_m menu_title) (v${LVNODE_VER}) ================${NC}"
    cmd_version
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}1.${NC} $(_m m_list)"
    echo -e "  ${GRN}2.${NC} $(_m m_new)"
    echo -e "  ${GRN}3.${NC} $(_m m_remove)"
    echo -e "  ${GRN}4.${NC} $(_m m_rename)"
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}5.${NC} $(_m m_start)"
    echo -e "  ${GRN}6.${NC} $(_m m_stop)"
    echo -e "  ${GRN}7.${NC} $(_m m_restart)"
    echo -e "  ${GRN}8.${NC} $(_m m_enable)"
    echo -e "  ${GRN}9.${NC} $(_m m_disable)"
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}10.${NC} $(_m m_log)"
    echo -e "  ${GRN}11.${NC} $(_m m_config)"
    echo -e "  ${GRN}12.${NC} $(_m m_update)"
    echo -e "  ${GRN}13.${NC} $(_m m_self_update)"
    echo -e "  ${GRN}14.${NC} $(_m m_bbr)"
    echo -e "  ${GRN}15.${NC} $(_m m_speedtest)"
    echo -e "  ${RED}16.${NC} $(_m m_uninstall)"
    echo -e "  ${YEL}0.${NC} $(_m m_exit)"
    echo "--------------------------------------------------------------------"
    local ch="" target="" old_n="" new_n="" ver=""
    # Exit immediately on SSH disconnect / EOF (rc != 0) or 10-minute idle timeout to prevent CPU spin!
    if ! read -t 600 -rp "$(_m m_choose)" ch; then
      echo ""
      exit 0
    fi
    case "${ch:-}" in
      1)  cmd_list ;;
      2)  read -t 600 -rp "$(_m m_new_name)" new_n || { echo ""; exit 0; }; [ -n "${new_n:-}" ] && (cmd_new "$new_n") || true ;;
      3)  cmd_list; read -t 600 -rp "$(_m m_del_name)" target || { echo ""; exit 0; }; [ -n "${target:-}" ] && (cmd_remove "$target") || true ;;
      4)  cmd_list; read -t 600 -rp "$(_m m_old_name)" old_n || { echo ""; exit 0; }; read -t 600 -rp "$(_m m_new_rename)" new_n || { echo ""; exit 0; }; [ -n "${old_n:-}" ] && [ -n "${new_n:-}" ] && (cmd_rename "$old_n" "$new_n") || true ;;
      5)  target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_svc_act start "$target") || true ;;
      6)  target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_svc_act stop "$target") || true ;;
      7)  target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_svc_act restart "$target") || true ;;
      8)  target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_svc_act enable "$target") || true ;;
      9)  target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_svc_act disable "$target") || true ;;
      10) target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_log "$target") || true ;;
      11) target="$(pick_inst_interactive)" || { echo ""; exit 0; }; (cmd_config "$target" -e) || true ;;
      12) read -t 600 -rp "$(_m m_ver_prompt)" ver || { echo ""; exit 0; }; (cmd_update "${ver:-}") || true ;;
      13) (cmd_self_update) || true ;;
      14) (cmd_bbr) || true ;;
      15) (cmd_speedtest) || true ;;
      16) (cmd_uninstall) || true; break ;;
      0|q|exit) exit 0 ;;
      *) warn "$(_m invalid_choice)" ;;
    esac
  done
}

# ── Parse --lang flag before action ──
ACTION=""
ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --lang)
      shift || true
      LN="${1:-en}"
      ;;
    --lang=*)
      LN="${1#--lang=}"
      ;;
    *)
      if [ -z "$ACTION" ]; then
        ACTION="$1"
      else
        ARGS+=("$1")
      fi
      ;;
  esac
  shift || true
done

case "$ACTION" in
  "")                     interactive_menu ;;
  list|ls)                cmd_list ;;
  status)                 if [ -n "${ARGS[0]:-}" ]; then resolve_inst "${ARGS[0]}"; echo -e "$INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"; systemctl status "$INST_SVC" --no-pager -l 2>/dev/null | sed -n '1,8p'; else cmd_list; fi ;;
  new|add|create)         cmd_new ${ARGS[@]+"${ARGS[@]}"} ;;
  remove|rm|del|delete)   cmd_remove ${ARGS[@]+"${ARGS[@]}"} ;;
  rename|mv)              cmd_rename ${ARGS[@]+"${ARGS[@]}"} ;;
  start|stop|restart|reload|enable|disable)
                          cmd_svc_act "$ACTION" "${ARGS[0]:-}" ;;
  log|logs|access)        cmd_log ${ARGS[@]+"${ARGS[@]}"} ;;
  config|cfg)             cmd_config ${ARGS[@]+"${ARGS[@]}"} ;;
  update|upgrade)         cmd_update "${ARGS[0]:-}" ;;
  self-update|selfupdate) cmd_self_update ;;
  version|-v|--version)   cmd_version ;;
  bbr)                    cmd_bbr ;;
  speedtest)              cmd_speedtest ;;
  uninstall)              cmd_uninstall ;;
  -h|--help|help)         usage ;;
  *)                      warn "$(_m unknown_cmd): '$ACTION'"; usage; exit 1 ;;
esac
