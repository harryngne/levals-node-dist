#!/bin/bash
# lvnode · Trình quản lý đa instance cho levals-node
set -uo pipefail

LVNODE_VER="2.2.0"
BIN="/usr/local/bin/levals-node"
RAW_BASE="https://raw.githubusercontent.com/harryngne/levals-node-dist/main"
REL_BASE="https://github.com/harryngne/levals-node-dist/releases"

RED='\033[31m'; GRN='\033[32m'; YEL='\033[33m'; BLU='\033[36m'; CYN='\033[96m'; BLD='\033[1m'; NC='\033[0m'

info(){ echo -e "${BLU}==${NC} $*"; }
ok(){   echo -e "${GRN}✓${NC} $*"; }
warn(){ echo -e "${YEL}! $*${NC}"; }
die(){  echo -e "${RED}✗ $*${NC}" >&2; exit 1; }
need_root(){ [ "$(id -u)" = 0 ] || die "Cần chạy bằng quyền root (sudo)."; }

# ── Ánh xạ tên instance -> tên service systemd & thư mục cấu hình ──
# Instance mặc định ("", "default", "levals-node"):
#   service = levals-node          dir = /etc/levals-node
# Instance đặt tên ("<name>"):
#   service = levals-node-<name>   dir = /etc/levals-node-<name>
INST_LABEL="default"
INST_SVC="levals-node"
INST_DIR="/etc/levals-node"
INST_CFG="/etc/levals-node/config.yml"
INST_UNIT="/etc/systemd/system/levals-node.service"

resolve_inst(){
  local raw="${1:-}"
  raw="${raw%.service}"
  if [ -z "$raw" ] || [ "$raw" = "default" ] || [ "$raw" = "levals-node" ]; then
    INST_LABEL="default"
    INST_SVC="levals-node"
    INST_DIR="/etc/levals-node"
  else
    raw="${raw#levals-node-}"
    [[ "$raw" =~ ^[a-zA-Z0-9._-]+$ ]] || die "Tên instance không hợp lệ: '$raw' (chỉ dùng chữ, số, ., _, -)."
    INST_LABEL="$raw"
    INST_SVC="levals-node-$raw"
    INST_DIR="/etc/levals-node-$raw"
  fi
  INST_CFG="$INST_DIR/config.yml"
  INST_UNIT="/etc/systemd/system/$INST_SVC.service"
}

inst_exists(){
  [ -f "$INST_UNIT" ] || [ -d "$INST_DIR" ]
}

# Thu thập danh sách tất cả các instance hiện có (trả về tên truyền vào resolve_inst)
all_instances(){
  local found=()
  if [ -f "/etc/systemd/system/levals-node.service" ] || [ -f "/etc/levals-node/config.yml" ]; then
    found+=("default")
  fi
  local p n
  for p in /etc/systemd/system/levals-node-*.service /etc/levals-node-*; do
    [ -e "$p" ] || continue
    n="$(basename "$p")"
    n="${n%.service}"
    n="${n#levals-node-}"
    [ -n "$n" ] || continue
    local dup=0 x
    for x in "${found[@]:-}"; do [ "$x" = "$n" ] && { dup=1; break; }; done
    [ "$dup" = 0 ] && found+=("$n")
  done
  printf '%s\n' "${found[@]:-}" | sed '/^$/d'
}

svc_state_badge(){
  local svc="$1"
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    echo -e "${GRN}đang chạy${NC}"
  elif systemctl is-failed --quiet "$svc" 2>/dev/null; then
    echo -e "${RED}lỗi / tự restart${NC}"
  else
    echo -e "${YEL}đã dừng${NC}"
  fi
}

svc_boot_badge(){
  local svc="$1"
  if systemctl is-enabled --quiet "$svc" 2>/dev/null; then
    echo -e "${GRN}tự bật${NC}"
  else
    echo -e "${YEL}tắt${NC}"
  fi
}

# Đọc nhanh giá trị khoá YAML đơn giản từ config.yml
yaml_get(){
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -F':' -v k="$key" '
    $0 ~ "^[[:space:]]*"k"[[:space:]]*:" {
      sub("^[[:space:]]*"k"[[:space:]]*:[[:space:]]*", "", $0)
      sub("[[:space:]]+#.*$", "", $0)
      gsub(/^["'\'']|["'\'']$/, "", $0)
      print $0
      exit
    }
  ' "$file"
}

# Sinh file systemd chuẩn (tự restart kể cả khi token hết hạn / bị ngắt / bị xoá để tự phục hồi ngay khi gia hạn)
write_unit(){
  local svc="$1" cfg="$2" unit="/etc/systemd/system/${1}.service"
  cat > "$unit" <<UNIT
[Unit]
Description=$svc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=$BIN -c $cfg
Restart=always
RestartSec=5
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
UNIT
}

# Sinh dns.yml & routes.yml mặc định cho instance mới nếu chưa có
ensure_default_rules(){
  local dir="$1"
  mkdir -p "$dir"
  if [ ! -f "$dir/dns.yml" ]; then
    if [ -f "/etc/levals-node/dns.yml" ] && [ "$dir" != "/etc/levals-node" ]; then
      cp -f "/etc/levals-node/dns.yml" "$dir/dns.yml"
    else
      cat > "$dir/dns.yml" <<'DNS'
strategy: ipv4_first
servers:
  - 1.1.1.1
  - 8.8.8.8
rules:
  - domains: ["keyword:doubleclick", "keyword:adsserver", "keyword:adservice", "keyword:pagead", "keyword:googleads", "keyword:googlesyndication"]
    block: true
  - domains: [ads.google.com, ads.yahoo.com, ads.facebook.com, an.facebook.com, analytics.google.com, pixel.facebook.com, ads-api.twitter.com, tracking.mixpanel.com]
    block: true
DNS
    fi
  fi
  if [ ! -f "$dir/routes.yml" ]; then
    if [ -f "/etc/levals-node/routes.yml" ] && [ "$dir" != "/etc/levals-node" ]; then
      cp -f "/etc/levals-node/routes.yml" "$dir/routes.yml"
    else
      cat > "$dir/routes.yml" <<'ROUTES'
settings:
  block_quic: true
  block_bt: true
  block_private: true

block:
  - type: domain
    values:
      - ads.google.com
      - pagead2.googlesyndication.com
      - googleads.g.doubleclick.net
      - ad.doubleclick.net
      - adservice.google.com
      - ads.yahoo.com
      - ads.facebook.com
      - an.facebook.com
      - pixel.facebook.com
      - analytics.google.com
      - tracking.mixpanel.com
      - ads-api.twitter.com
  - type: keyword
    values:
      - torrent
      - tracker
      - announce
      - peer-exchange
      - seed-peer
  - type: ip
    values: []
ROUTES
    fi
  fi
}

# Chuẩn hoá giá trị YAML (số nguyên / bool giữ nguyên, chuỗi bọc ngoặc kép)
fmt_yaml_val(){
  local v="$1"
  if [[ "$v" =~ ^[0-9]+$ ]] || [[ "$v" =~ ^(true|false)$ ]]; then
    printf '%s' "$v"
  else
    v="${v//\\/\\\\}"
    v="${v//\"/\\\"}"
    printf '"%s"' "$v"
  fi
}

# Cập nhật hoặc thêm mới k=v vào file config.yml
set_yaml_kv(){
  local file="$1" raw_k="$2" raw_v="$3"
  local k="$raw_k"
  case "$raw_k" in
    PANEL_URL|url)         k="api_host" ;;
    TOKEN|token)           k="api_key" ;;
    NODE_ID)               k="node_id" ;;
    LEVALS_KEY)            k="levals_key" ;;
    PANEL_KIND|kind|type)  k="server_type" ;;
    NODE_TYPE)             k="node_type" ;;
    LOG_LEVEL|log_level)   k="log.level" ;;
    LOG_ACCESS|log_access) k="log.access" ;;
  esac
  local fv
  fv="$(fmt_yaml_val "$raw_v")"

  if [[ "$k" == *.* ]]; then
    local sec="${k%%.*}" sub="${k#*.}"
    if grep -qE "^${sec}:[[:space:]]*$" "$file" 2>/dev/null; then
      if awk -v s="$sec" -v sk="$sub" '
        $0 ~ "^"s":[[:space:]]*$" { in_s=1; next }
        in_s && $0 ~ "^[^[:space:]#]" { in_s=0 }
        in_s && $0 ~ "^[[:space:]]+"sk":[[:space:]]*" { found=1 }
        END { exit(found ? 0 : 1) }
      ' "$file"; then
        awk -v s="$sec" -v sk="$sub" -v val="$fv" '
          $0 ~ "^"s":[[:space:]]*$" { in_s=1; print; next }
          in_s && $0 ~ "^[^[:space:]#]" { in_s=0 }
          in_s && $0 ~ "^[[:space:]]+"sk":[[:space:]]*" {
            print "  " sk ": " val
            in_s=0
            next
          }
          { print }
        ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
      else
        awk -v s="$sec" -v sk="$sub" -v val="$fv" '
          $0 ~ "^"s":[[:space:]]*$" { print; print "  " sk ": " val; next }
          { print }
        ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
      fi
    else
      printf '\n%s:\n  %s: %s\n' "$sec" "$sub" "$fv" >> "$file"
    fi
  else
    if grep -qE "^${k}:[[:space:]]*" "$file" 2>/dev/null; then
      awk -v k="$k" -v val="$fv" '
        !done && $0 ~ "^"k":[[:space:]]*" { print k ": " val; done=1; next }
        { print }
      ' "$file" > "$file.tmp" && mv -f "$file.tmp" "$file"
    else
      printf '%s: %s\n' "$k" "$fv" >> "$file"
    fi
  fi
}

usage(){
  echo -e ""
  echo -e "${BLD}Cách sử dụng script quản lý lvnode:${NC}"
  echo "--------------------------------------------------------------------"
  echo "lvnode                              - Hiển thị menu quản lý (nhiều tính năng)"
  echo "lvnode list                         - Liệt kê các instance hiện có & trạng thái"
  echo "lvnode new <name> [k1=v1 ...]       - Tạo instance mới"
  echo "lvnode remove <name> [name...]      - Xoá một hoặc nhiều instance"
  echo "lvnode rename <old_name> <new_name> - Đổi tên instance"
  echo "lvnode start [name]                 - Khởi động instance"
  echo "lvnode stop [name]                  - Dừng instance"
  echo "lvnode restart [name]               - Khởi động lại instance"
  echo "lvnode enable [name]                - Bật tự chạy khi khởi động máy"
  echo "lvnode disable [name]               - Tắt tự chạy khi khởi động máy"
  echo "lvnode log [name]                   - Xem log realtime hợp nhất (agent + client)"
  echo "lvnode log [name] -n <số_dòng>      - Xem N dòng log gần nhất (không chờ)"
  echo "lvnode config [name]                - Xem file cấu hình của instance"
  echo "lvnode config [name] -e             - Sửa file cấu hình bằng nano/vi"
  echo "lvnode config [name] k1=v1 k2=v2    - Sửa hoặc thêm cấu hình & tự restart"
  echo "lvnode update [version]             - Cài đặt / cập nhật binary levals-node"
  echo "lvnode uninstall                    - Gỡ cài đặt hoàn toàn levals-node"
  echo "lvnode self-update                  - Cập nhật script quản lý lvnode"
  echo "lvnode version                      - Xem phiên bản"
  echo "--------------------------------------------------------------------"
}

cmd_list(){
  local items=()
  while IFS= read -r line; do [ -n "$line" ] && items+=("$line"); done < <(all_instances)
  if [ "${#items[@]}" -eq 0 ]; then
    warn "Chưa có instance nào được tạo."
    return 0
  fi
  printf "\n${BLD}%-16s %-24s %-16s %-8s %-10s %s${NC}\n" "INSTANCE" "TRẠNG THÁI" "KHỞI ĐỘNG" "NODE_ID" "LOẠI" "PANEL"
  echo "----------------------------------------------------------------------------------------"
  local it nid stype host
  for it in "${items[@]}"; do
    resolve_inst "$it"
    nid="$(yaml_get "$INST_CFG" "node_id")"
    stype="$(yaml_get "$INST_CFG" "server_type")"
    host="$(yaml_get "$INST_CFG" "api_host")"
    [ -z "$host" ] && host="$(yaml_get "$INST_CFG" "url")"
    printf "%-16s %-33b %-25b %-8s %-10s %s\n" \
      "$INST_LABEL" "$(svc_state_badge "$INST_SVC")" "$(svc_boot_badge "$INST_SVC")" \
      "${nid:--}" "${stype:-levals}" "${host:--}"
  done
  echo ""
}

cmd_new(){
  need_root
  local name="${1:-}"
  [ -n "$name" ] || die "Cách dùng: lvnode new <name> [api_host=... api_key=... node_id=... levals_key=...]"
  shift || true
  resolve_inst "$name"
  inst_exists && die "Instance '$INST_LABEL' đã tồn tại ($INST_DIR)."

  # Lấy mặc định kế thừa từ instance gốc nếu có sẵn để tạo node thứ 2 siêu nhanh
  local def_host="" def_key="" def_lkey="" def_type="levals"
  if [ -f "/etc/levals-node/config.yml" ]; then
    def_host="$(yaml_get /etc/levals-node/config.yml api_host)"
    [ -z "$def_host" ] && def_host="$(yaml_get /etc/levals-node/config.yml url)"
    def_key="$(yaml_get /etc/levals-node/config.yml api_key)"
    [ -z "$def_key" ] && def_key="$(yaml_get /etc/levals-node/config.yml token)"
    def_lkey="$(yaml_get /etc/levals-node/config.yml levals_key)"
    def_type="$(yaml_get /etc/levals-node/config.yml server_type)"
    [ -z "$def_type" ] && def_type="levals"
  fi

  ensure_default_rules "$INST_DIR"
  cat > "$INST_CFG" <<YML
server_type: "${def_type}"
api_host: "${def_host}"
api_key: "${def_key}"
node_id: 1
levals_key: "${def_lkey}"
core:
  engine: native
config_dir: "$INST_DIR"
log:
  level: "info"
YML

  local kv k v
  for kv in "$@"; do
    [[ "$kv" == *=* ]] || die "Tham số không hợp lệ '$kv' (cần dạng khoá=giá_trị)."
    k="${kv%%=*}"; v="${kv#*=}"
    set_yaml_kv "$INST_CFG" "$k" "$v"
  done

  # Nếu chưa truyền tham số trên dòng lệnh mà chạy ở terminal tương tác → hỏi nhanh các trường chính
  if [ "$#" -eq 0 ] && [ -t 0 ]; then
    local in_host in_key in_nid in_lkey in_ntype
    read -rp "Địa chỉ Panel (api_host) [${def_host}]: " in_host
    [ -n "${in_host:-}" ] && set_yaml_kv "$INST_CFG" "api_host" "$in_host"
    read -rp "Token Panel (api_key) [${def_key:+đã kế thừa}]: " in_key
    [ -n "${in_key:-}" ] && set_yaml_kv "$INST_CFG" "api_key" "$in_key"
    read -rp "Node ID [1]: " in_nid
    [ -n "${in_nid:-}" ] && set_yaml_kv "$INST_CFG" "node_id" "$in_nid"
    read -rp "Giấy phép levals_key [${def_lkey:+đã kế thừa}]: " in_lkey
    [ -n "${in_lkey:-}" ] && set_yaml_kv "$INST_CFG" "levals_key" "$in_lkey"
    read -rp "Loại giao thức node_type (để trống nếu dùng panel levals): " in_ntype
    [ -n "${in_ntype:-}" ] && set_yaml_kv "$INST_CFG" "node_type" "$in_ntype"
  fi

  write_unit "$INST_SVC" "$INST_CFG"
  systemctl daemon-reload
  systemctl enable -q "$INST_SVC" 2>/dev/null || true
  systemctl restart "$INST_SVC"
  ok "Đã tạo & khởi động instance '$INST_LABEL' ($INST_SVC) → $(svc_state_badge "$INST_SVC")"
}

cmd_remove(){
  need_root
  [ "$#" -ge 1 ] || die "Cách dùng: lvnode remove <name> [name...]"
  local name
  for name in "$@"; do
    resolve_inst "$name"
    if ! inst_exists; then
      warn "Không tìm thấy instance '$INST_LABEL' — bỏ qua."
      continue
    fi
    systemctl stop "$INST_SVC" 2>/dev/null || true
    systemctl disable -q "$INST_SVC" 2>/dev/null || true
    rm -f "$INST_UNIT"
    rm -rf "$INST_DIR"
    ok "Đã xoá instance '$INST_LABEL' ($INST_SVC)"
  done
  systemctl daemon-reload 2>/dev/null || true
}

cmd_rename(){
  need_root
  local old_n="${1:-}" new_n="${2:-}"
  [ -n "$old_n" ] && [ -n "$new_n" ] || die "Cách dùng: lvnode rename <old_name> <new_name>"
  resolve_inst "$old_n"
  local old_label="$INST_LABEL" old_svc="$INST_SVC" old_dir="$INST_DIR" old_unit="$INST_UNIT"
  inst_exists || die "Instance '$old_label' không tồn tại."

  resolve_inst "$new_n"
  local new_label="$INST_LABEL" new_svc="$INST_SVC" new_dir="$INST_DIR" new_cfg="$INST_CFG"
  inst_exists && die "Instance '$new_label' đã tồn tại."

  systemctl stop "$old_svc" 2>/dev/null || true
  systemctl disable -q "$old_svc" 2>/dev/null || true
  rm -f "$old_unit"

  mv "$old_dir" "$new_dir"
  [ -f "$new_cfg" ] && set_yaml_kv "$new_cfg" "config_dir" "$new_dir"
  write_unit "$new_svc" "$new_cfg"
  systemctl daemon-reload
  systemctl enable -q "$new_svc" 2>/dev/null || true
  systemctl restart "$new_svc"
  ok "Đã đổi tên instance '$old_label' → '$new_label' ($new_svc): $(svc_state_badge "$new_svc")"
}

cmd_svc_act(){
  local act="$1" target="${2:-}"
  need_root
  resolve_inst "$target"
  inst_exists || die "Instance '$INST_LABEL' không tồn tại (dùng 'lvnode list' để kiểm tra)."
  case "$act" in
    start|stop|restart)
      systemctl "$act" "$INST_SVC"
      echo -e "$INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"
      ;;
    reload)
      systemctl restart "$INST_SVC"
      echo -e "Đã nạp lại cấu hình $INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"
      ;;
    enable)
      systemctl enable -q "$INST_SVC"
      ok "Đã bật tự khởi động cùng máy cho '$INST_LABEL' ($INST_SVC)."
      ;;
    disable)
      systemctl disable -q "$INST_SVC"
      ok "Đã tắt tự khởi động cùng máy cho '$INST_LABEL' ($INST_SVC)."
      ;;
  esac
}

# Lệnh log DUY NHẤT hợp nhất cả log hệ thống agent + log kết nối client realtime
cmd_log(){
  local inst="" follow=1 lines=200 explicit_no_follow=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -f|--follow) follow=1 ;;
      --no-follow) follow=0; explicit_no_follow=1 ;;
      -n|--lines)
        shift || die "Thiếu số dòng sau -n"
        lines="${1:-1000}"
        [ "$explicit_no_follow" = 0 ] && follow=0
        ;;
      -n*)
        lines="${1#-n}"
        [ "$explicit_no_follow" = 0 ] && follow=0
        ;;
      *)
        if [ -z "$inst" ]; then inst="$1"; else die "Tham số không rõ: $1"; fi
        ;;
    esac
    shift || true
  done

  resolve_inst "$inst"
  inst_exists || die "Instance '$INST_LABEL' không tồn tại."

  if [ "$follow" -eq 1 ]; then
    echo -e "${GRN}Đang xem log realtime hợp nhất của '$INST_LABEL' ($INST_SVC) — bấm Ctrl+C để thoát:${NC}"
    # Với binary cũ (< 0.26.1) chưa gộp access.log vào stdout, tự ghép luồng access.log nếu có
    local bver
    bver="$("$BIN" --version 2>/dev/null | awk '{print $2}')"
    if [ -n "$bver" ] && [ "$(printf '%s\n0.26.1\n' "$bver" | sort -V | head -n1)" != "0.26.1" ] && [ -f "$INST_DIR/access.log" ]; then
      trap 'kill 0 2>/dev/null; exit 0' INT TERM EXIT
      tail -n 50 -f "$INST_DIR/access.log" &
      journalctl -u "$INST_SVC" -n "$lines" -f --no-hostname
    else
      exec journalctl -u "$INST_SVC" -n "$lines" -f --no-hostname
    fi
  else
    journalctl -u "$INST_SVC" -n "${lines:-1000}" --no-pager --no-hostname
  fi
}

cmd_config(){
  local inst="" edit_mode=0 kvs=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -e|--edit|edit) edit_mode=1 ;;
      *=*) kvs+=("$1") ;;
      *)
        if [ -z "$inst" ] && [ "${#kvs[@]}" -eq 0 ]; then
          inst="$1"
        else
          die "Tham số cấu hình không hợp lệ: '$1' (cần dạng k1=v1)."
        fi
        ;;
    esac
    shift || true
  done

  resolve_inst "$inst"
  [ -f "$INST_CFG" ] || die "Chưa có file cấu hình $INST_CFG."

  if [ "${#kvs[@]}" -gt 0 ]; then
    need_root
    local kv k v
    for kv in "${kvs[@]}"; do
      k="${kv%%=*}"; v="${kv#*=}"
      set_yaml_kv "$INST_CFG" "$k" "$v"
      ok "Đã đặt $k trong $INST_CFG"
    done
    if [ -f "$INST_UNIT" ]; then
      systemctl restart "$INST_SVC"
      ok "Đã tự khởi động lại '$INST_LABEL' ($INST_SVC): $(svc_state_badge "$INST_SVC")"
    fi
    return 0
  fi

  if [ "$edit_mode" -eq 1 ]; then
    need_root
    local ed="${EDITOR:-}"
    [ -z "$ed" ] && for e in nano vi vim; do command -v "$e" >/dev/null 2>&1 && { ed="$e"; break; }; done
    [ -n "$ed" ] || die "Không tìm thấy nano/vi/vim. Xem file tại: $INST_CFG"
    "$ed" "$INST_CFG"
    if [ -t 0 ] && [ -f "$INST_UNIT" ]; then
      read -rp "Khởi động lại '$INST_LABEL' để áp dụng thay đổi? [Y/n]: " ans
      [[ "${ans:-Y}" =~ ^[Yy]$ ]] && { systemctl restart "$INST_SVC"; ok "$INST_SVC: $(svc_state_badge "$INST_SVC")"; }
    fi
    return 0
  fi

  echo -e "${BLD}# Instance: $INST_LABEL ($INST_CFG)${NC}"
  echo "--------------------------------------------------------------------"
  cat "$INST_CFG"
  echo "--------------------------------------------------------------------"
  echo -e "Mẹo: sửa nhanh bằng ${CYN}lvnode config${inst:+ $inst} k1=v1${NC} hoặc mở trình sửa bằng ${CYN}lvnode config${inst:+ $inst} -e${NC}"
}

detect_arch(){
  case "$(uname -m)" in
    x86_64|amd64)  echo "x86_64" ;;
    aarch64|arm64) echo "aarch64" ;;
    *) die "Kiến trúc $(uname -m) chưa hỗ trợ (chỉ hỗ trợ x86_64 và aarch64)." ;;
  esac
}

# Đồng bộ lại toàn bộ unit systemd hiện có sang cấu hình tự restart mới (bỏ RestartPreventExitStatus=2)
upgrade_all_units(){
  local items=() it
  while IFS= read -r it; do [ -n "$it" ] && items+=("$it"); done < <(all_instances)
  for it in "${items[@]:-}"; do
    resolve_inst "$it"
    if [ -f "$INST_UNIT" ]; then
      sed -i '/^RestartPreventExitStatus=/d' "$INST_UNIT" 2>/dev/null || true
      grep -q '^StartLimitIntervalSec=' "$INST_UNIT" 2>/dev/null || \
        sed -i '/^\[Unit\]/a StartLimitIntervalSec=0' "$INST_UNIT" 2>/dev/null || true
      sed -i 's/^Restart=.*/Restart=always/' "$INST_UNIT" 2>/dev/null || true
    fi
  done
  systemctl daemon-reload 2>/dev/null || true
}

tune_network_sysctls(){
  modprobe tcp_bbr 2>/dev/null || true
  mkdir -p /etc/sysctl.d 2>/dev/null || true
  cat > /etc/sysctl.d/99-levals-node.conf <<'SYSCTL'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_keepalive_time = 25
net.ipv4.tcp_keepalive_intvl = 10
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_slow_start_after_idle = 0
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576
net.core.netdev_max_backlog = 16384
net.core.somaxconn = 8192
net.ipv4.ip_local_port_range = 10240 65535
SYSCTL
  sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-levals-node.conf >/dev/null 2>&1 || true

  if ! systemctl is-active --quiet xboard-node 2>/dev/null; then
    if crontab -l 2>/dev/null | grep -q 'xbn-kcfg'; then
      crontab -l 2>/dev/null | grep -v 'xbn-kcfg' | crontab - 2>/dev/null || true
      ok "Đã gỡ cron xbn-kcfg cũ (tránh tranh chấp session WireGuard)."
    fi
    rm -f /etc/cron.d/xbn-kcfg* /usr/local/bin/xbn-kcfg*.sh 2>/dev/null || true
    local dev
    for dev in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | grep -E '^sgw[0-9]+$' || true); do
      wg-quick down "$dev" >/dev/null 2>&1 || ip link del "$dev" >/dev/null 2>&1 || true
      systemctl disable --now "wg-quick@${dev}" >/dev/null 2>&1 || true
      ok "Đã hạ interface WireGuard cũ: $dev"
    done
  fi
}

cmd_update(){
  need_root
  local req_ver="${1:-}"
  local narch url tag
  narch="$(detect_arch)"
  if [ -n "$req_ver" ]; then
    tag="v${req_ver#v}"
    url="$REL_BASE/download/$tag/levals-node-linux-$narch"
    info "Đang tải levals-node phiên bản $tag ($narch)…"
  else
    url="$REL_BASE/latest/download/levals-node-linux-$narch"
    info "Đang tải levals-node bản mới nhất ($narch)…"
  fi

  mkdir -p /usr/local/bin
  curl -fL --retry 3 -o "$BIN.new" "$url" || die "Không tải được binary từ $url (kiểm tra tên phiên bản hoặc kết nối mạng)."
  [ -s "$BIN.new" ] || die "File tải về rỗng."
  chmod +x "$BIN.new"
  mv -f "$BIN.new" "$BIN"
  ok "Đã cập nhật binary: $($BIN --version 2>/dev/null || echo 'OK')"

  # Tự cập nhật luôn script lvnode mới nhất (nếu tải được)
  if curl -fsSL --retry 2 -o /usr/local/bin/lvnode.new "$RAW_BASE/lvnode?$(date +%s)" 2>/dev/null && head -n1 /usr/local/bin/lvnode.new | grep -q '^#!/bin/bash'; then
    chmod +x /usr/local/bin/lvnode.new
    mv -f /usr/local/bin/lvnode.new /usr/local/bin/lvnode
    ok "Đã đồng bộ script quản lý lvnode mới nhất."
  else
    rm -f /usr/local/bin/lvnode.new
  fi

  tune_network_sysctls
  upgrade_all_units

  local items=() it
  while IFS= read -r it; do [ -n "$it" ] && items+=("$it"); done < <(all_instances)
  for it in "${items[@]:-}"; do
    resolve_inst "$it"
    if [ -f "$INST_UNIT" ]; then
      systemctl restart "$INST_SVC" 2>/dev/null || true
      ok "Đã khởi động lại '$INST_LABEL' ($INST_SVC): $(svc_state_badge "$INST_SVC")"
    fi
  done
}

cmd_self_update(){
  need_root
  info "Đang cập nhật script quản lý lvnode…"
  curl -fsSL --retry 3 -o /usr/local/bin/lvnode.new "$RAW_BASE/lvnode?$(date +%s)" \
    || die "Không tải được script lvnode từ GitHub."
  head -n1 /usr/local/bin/lvnode.new | grep -q '^#!/bin/bash' \
    || { rm -f /usr/local/bin/lvnode.new; die "Nội dung tải về không hợp lệ."; }
  chmod +x /usr/local/bin/lvnode.new
  mv -f /usr/local/bin/lvnode.new /usr/local/bin/lvnode
  local new_ver
  new_ver="$(grep -m1 '^LVNODE_VER=' /usr/local/bin/lvnode | cut -d'"' -f2)"
  ok "Đã cập nhật lvnode thành công (v${new_ver:-$LVNODE_VER})."
}

cmd_version(){
  local bver="chưa cài"
  [ -x "$BIN" ] && bver="$("$BIN" --version 2>/dev/null | awk '{print $2}')"
  echo -e "${BLD}levals-node${NC} : ${GRN}${bver}${NC} ($(uname -m), engine: native Rust)"
  echo -e "${BLD}lvnode CLI${NC}  : v${LVNODE_VER}"
}

cmd_bbr(){
  need_root
  tune_network_sysctls
  local cc qd
  cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo '?')"
  qd="$(sysctl -n net.core.default_qdisc 2>/dev/null || echo '?')"
  [ "$cc" = "bbr" ] && ok "BBR + tối ưu mạng đã bật (congestion=$cc, qdisc=$qd)" || warn "Đã áp dụng tối ưu mạng; chưa bật được BBR (congestion=$cc, cần kernel >= 4.9)."
}

cmd_speedtest(){
  if command -v speedtest >/dev/null 2>&1; then speedtest
  elif command -v speedtest-cli >/dev/null 2>&1; then speedtest-cli
  else
    need_root
    info "Đang cài speedtest-cli…"
    (apt-get update -qq && apt-get install -y -qq speedtest-cli) >/dev/null 2>&1 \
      || yum install -y -q speedtest-cli >/dev/null 2>&1 \
      || pip3 install -q speedtest-cli >/dev/null 2>&1 || true
    command -v speedtest-cli >/dev/null 2>&1 && speedtest-cli || die "Không cài được speedtest-cli."
  fi
}

cmd_uninstall(){
  need_root
  if [ -t 0 ] && [ "${FORCE:-0}" != "1" ]; then
    read -rp "Bạn có chắc chắn muốn gỡ hoàn toàn levals-node và mọi instance? [y/N]: " ans
    [[ "${ans:-N}" =~ ^[Yy]$ ]] || { echo "Đã huỷ."; return 0; }
  fi
  curl -fsSL "$RAW_BASE/uninstall.sh?$(date +%s)" | bash
}

pick_inst_interactive(){
  local prompt="${1:-Tên instance (Enter = default)}: " inp
  read -rp "$prompt" inp
  printf '%s' "${inp:-}"
}

interactive_menu(){
  if [ ! -t 0 ]; then
    cmd_version
    cmd_list
    usage
    return 0
  fi
  while true; do
    echo -e ""
    echo -e "${BLD}================ Menu quản lý levals-node (v${LVNODE_VER}) ================${NC}"
    cmd_version
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}1.${NC} Liệt kê các instance & trạng thái (list)"
    echo -e "  ${GRN}2.${NC} Tạo instance mới (new)"
    echo -e "  ${GRN}3.${NC} Xoá instance (remove)"
    echo -e "  ${GRN}4.${NC} Đổi tên instance (rename)"
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}5.${NC} Khởi động instance (start)"
    echo -e "  ${GRN}6.${NC} Dừng instance (stop)"
    echo -e "  ${GRN}7.${NC} Khởi động lại instance (restart)"
    echo -e "  ${GRN}8.${NC} Bật tự chạy khi khởi động máy (enable)"
    echo -e "  ${GRN}9.${NC} Tắt tự chạy khi khởi động máy (disable)"
    echo "--------------------------------------------------------------------"
    echo -e "  ${GRN}10.${NC} Xem log realtime hợp nhất (log)"
    echo -e "  ${GRN}11.${NC} Xem / Sửa file cấu hình (config)"
    echo -e "  ${GRN}12.${NC} Cập nhật binary levals-node (update)"
    echo -e "  ${GRN}13.${NC} Cập nhật script quản lý lvnode (self-update)"
    echo -e "  ${GRN}14.${NC} Bật tăng tốc BBR + fq (bbr)"
    echo -e "  ${GRN}15.${NC} Đo tốc độ mạng máy chủ (speedtest)"
    echo -e "  ${RED}16.${NC} Gỡ cài đặt hoàn toàn levals-node (uninstall)"
    echo -e "  ${YEL}0.${NC} Thoát"
    echo "--------------------------------------------------------------------"
    local ch target old_n new_n ver
    read -rp "Chọn chức năng [0-16]: " ch
    case "${ch:-}" in
      1)  cmd_list ;;
      2)  read -rp "Nhập tên instance mới (VD: sg2): " new_n; [ -n "${new_n:-}" ] && (cmd_new "$new_n") || true ;;
      3)  cmd_list; read -rp "Nhập tên instance cần xoá: " target; [ -n "${target:-}" ] && (cmd_remove "$target") || true ;;
      4)  cmd_list; read -rp "Tên cũ: " old_n; read -rp "Tên mới: " new_n; [ -n "${old_n:-}" ] && [ -n "${new_n:-}" ] && (cmd_rename "$old_n" "$new_n") || true ;;
      5)  target="$(pick_inst_interactive)"; (cmd_svc_act start "$target") || true ;;
      6)  target="$(pick_inst_interactive)"; (cmd_svc_act stop "$target") || true ;;
      7)  target="$(pick_inst_interactive)"; (cmd_svc_act restart "$target") || true ;;
      8)  target="$(pick_inst_interactive)"; (cmd_svc_act enable "$target") || true ;;
      9)  target="$(pick_inst_interactive)"; (cmd_svc_act disable "$target") || true ;;
      10) target="$(pick_inst_interactive)"; (cmd_log "$target") || true ;;
      11) target="$(pick_inst_interactive)"; (cmd_config "$target" -e) || true ;;
      12) read -rp "Phiên bản cần cài (Enter = bản mới nhất): " ver; (cmd_update "${ver:-}") || true ;;
      13) (cmd_self_update) || true ;;
      14) (cmd_bbr) || true ;;
      15) (cmd_speedtest) || true ;;
      16) (cmd_uninstall) || true; break ;;
      0|q|exit) exit 0 ;;
      *) warn "Lựa chọn không hợp lệ." ;;
    esac
  done
}

ACTION="${1:-}"
[ "$#" -gt 0 ] && shift || true

case "$ACTION" in
  "")                     interactive_menu ;;
  list|ls)                cmd_list ;;
  status)                 if [ -n "${1:-}" ]; then resolve_inst "$1"; echo -e "$INST_SVC ($INST_LABEL): $(svc_state_badge "$INST_SVC")"; systemctl status "$INST_SVC" --no-pager -l 2>/dev/null | sed -n '1,8p'; else cmd_list; fi ;;
  new|add|create)         cmd_new "$@" ;;
  remove|rm|del|delete)   cmd_remove "$@" ;;
  rename|mv)              cmd_rename "$@" ;;
  start|stop|restart|reload|enable|disable)
                          cmd_svc_act "$ACTION" "${1:-}" ;;
  log|logs|access)        cmd_log "$@" ;;
  config|cfg)             cmd_config "$@" ;;
  update|upgrade)         cmd_update "${1:-}" ;;
  self-update|selfupdate) cmd_self_update ;;
  version|-v|--version)   cmd_version ;;
  bbr)                    cmd_bbr ;;
  speedtest)              cmd_speedtest ;;
  uninstall)              cmd_uninstall ;;
  -h|--help|help)         usage ;;
  *)                      warn "Lệnh không rõ: '$ACTION'"; usage; exit 1 ;;
esac
